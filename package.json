{
  "name": "dreamy-laundry-api",
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/migrate.js && node src/server.js",
    "dev": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/migrate.js",
    "seed": "node --env-file=.env src/migrate.js --seed",
    "seed:demo": "node --env-file=.env src/migrate.js --seed --demo"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  }
}
